# 本机专用路径覆盖（示例）—— 复制成 local.env 后按需修改
#
#   cp local.env.example local.env
#
# local.env 已被 .gitignore 排除，不会进入仓库；build.sh 启动时会自动 source 它。

# 构建时需要在 PATH 里找到 `python`（仅用于生成 git header）
export PYTHON_DIR=/c/Users/<你>/python/3.13

# 无空格暂存目录（GCC specs 的 -T 不能带空格，所以不能直接在含空格的工程路径下构建）
export D3HACK_STAGE=/d/proj/d3hack-build

# devkitPro 若不在默认位置，在这里覆盖
# export DEVKITPRO=/opt/devkitpro
